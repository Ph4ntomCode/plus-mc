# Build (including variant dirs like build-asan/ and build-warn/)
/build/
/build-*/
cmake-build-*/

# Extracted vanilla data + downloads (large; regenerated by tools/vanilla-data)
data/vanilla/
*.jar

# A plugin's private data directory, created by the host at load time
examples/*/data/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Runtime logs (vanilla server experiments / ad-hoc runs)
/logs/

# Local test host (server.properties/eula.txt + a copy of a vanilla world)
/run-local/

# Local secrets — the Archil key lives in .env (see .env.example)
.env
.env.local
!.env.example

# Misc
.cache/
/Testing/
__pycache__/
*.pyc
.DS_Store
.ruff_cache/

# Imported Freebuff conversation dumps (local context, not project history)
/.cloud-attachments/
