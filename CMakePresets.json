{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 (MinGW-w64, Ninja)",
      "description": "A native build from an MSYS2 MINGW64 shell: gcc, zlib and OpenSSL come from the mingw-w64 packages. LLVM-MinGW works the same way from a shell with its bin directory on PATH.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4, "noTestsAction": "error" }
    }
  ]
}
